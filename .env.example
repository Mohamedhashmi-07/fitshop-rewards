# Server Configuration
PORT=5000
NODE_ENV=development

# Allowed Frontend Origins for CORS (comma-separated or single URL)
FRONTEND_URL=http://localhost:5173

# Database Configuration (PostgreSQL connection string)
# If left unset or unreachable, server will automatically fall back to data/database.json
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/fitshop_db

# Authentication
JWT_SECRET=YOUR_JWT_SECRET_KEY_CHANGE_IN_PRODUCTION
